# Fuente de datos pública: static (R1) | api (R3)
VITE_DATA_SOURCE=static
# Base de las llamadas desde el navegador
VITE_API_BASE_URL=/api
# URL absoluta que usa el loader en el build (solo modo api)
API_BUILD_URL=
# URL pública del sitio (canónicas, hreflang, sitemap, Open Graph)
VITE_SITE_URL=http://localhost:4173
# Incluye las rutas /admin en el build
VITE_ENABLE_ADMIN=false
# Mocks del admin en el navegador (solo desarrollo)
VITE_ENABLE_MSW=false
# Escena WebGL del hero (fase 2)
VITE_ENABLE_WEBGL_HERO=false
