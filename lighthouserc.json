{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-build.mjs",
      "startServerReadyPattern": "Build servido",
      "url": ["http://localhost:4173/es", "http://localhost:4173/en"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 184320 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
